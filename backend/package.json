{
  "name": "app-camin-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test",
    "migrate": "node src/migrate.js apply",
    "migrate:status": "node src/migrate.js status",
