{
  "name": "app-camin-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test",
    "migrate": "node src/migrate.js apply",
    "migrate:status": "node src/migrate.js status",
    "test:migrations": "node --test test-integration/migrations.integration.js",
    "invite:create": "node src/invite.js create",
    "invite:revoke": "node src/invite.js revoke",
    "equipment:access": "node src/service-status-access.js --equipment",
    "service-status:access": "node src/service-status-access.js",
    "sessions:cleanup": "node src/cleanup-sessions.js",
    "test:auth": "node --test test-integration/auth.integration.js",
    "test:reservations": "node --test test-integration/reservations.integration.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1177.0",
    "express": "^5.1.0",
    "heic-convert": "^2.1.0",
    "multer": "^2.5.0",
    "pg": "^8.16.0",
    "sharp": "^0.35.5",
    "web-push": "^4.0.0"
  }
}
