# Fixed local development ports.
FRONTEND_PORT=5173
BACKEND_PORT=3000
PGPORT=5432
PGHOST=db
# Demonstrative development database identifiers; not interview findings.
POSTGRES_DB=app_camin_demo
POSTGRES_USER=app_camin_demo
# Export POSTGRES_PASSWORD in your shell. Never save a password in this file.
